---
import { ATTRACTION } from '../config';
---

<section id="map" class="section">
  <div class="container">
    <h2 class="section-title">위치 지도</h2>
    <p class="section-lead">
      {ATTRACTION.address.street} · {ATTRACTION.plusCode}
    </p>
    <div class="map-wrap">
      <iframe
        title="강릉중앙시장 위치 지도"
        src={ATTRACTION.mapsEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
    <p class="muted small">
      <a href={ATTRACTION.mapsUrl} target="_blank" rel="noopener noreferrer"
        >Google 지도에서 크게 보기</a
      >
    </p>
  </div>
</section>

<style>
  .map-wrap {
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid #e7e0cf;
    box-shadow: 0 1px 2px rgba(15, 58, 48, 0.06);
  }
  .map-wrap iframe {
    width: 100%;
    height: 420px;
    border: 0;
    display: block;
  }
  .muted {
    color: #6b776f;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }
</style>
