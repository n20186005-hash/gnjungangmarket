---
import { ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].transport;
---

<section id="transport" class="section">
  <div class="container">
    <h2 class="section-title">{t.title}</h2>
    <p class="section-lead">{t.lead}</p>

    <div class="transport-grid">
      {
        t.cards.map((c) => (
          <div class="card">
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))
      }
    </div>

    <p class="muted small">{t.note}</p>
  </div>
</section>

<style>
  .transport-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.9rem;
  }
  .transport-grid h3 {
    margin: 0 0 0.5rem;
    color: var(--color-brand-dark);
    font-size: 1.05rem;
  }
  .transport-grid p {
    margin: 0;
    color: #36453f;
    font-size: 0.93rem;
  }
  .muted {
    color: #6b776f;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }
</style>
