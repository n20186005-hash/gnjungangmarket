---
import HeroSection from './HeroSection.astro';
import HoursSection from './HoursSection.astro';
import FoodSection from './FoodSection.astro';
import FacilitiesSection from './FacilitiesSection.astro';
import TransportSection from './TransportSection.astro';
import WeatherSection from './WeatherSection.astro';
import MapSection from './MapSection.astro';
import FaqSection from './FaqSection.astro';
import SourcesSection from './SourcesSection.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<HeroSection locale={locale} />
<HoursSection locale={locale} />
<FoodSection locale={locale} />
<FacilitiesSection locale={locale} />
<TransportSection locale={locale} />
<WeatherSection locale={locale} />
<MapSection locale={locale} />
<FaqSection locale={locale} />
<SourcesSection locale={locale} />
