---
import { FACILITIES, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const facilities = FACILITIES[locale];
const meta = ui[locale].facilities;
---

<section id="facilities" class="section">
  <div class="container">
    <h2 class="section-title">{meta.title}</h2>
    <p class="section-lead">{meta.lead}</p>
    <div class="fac-grid">
      {
        facilities.map((f) => (
          <div class="card fac-card">
            <span class="fac-icon">{f.icon}</span>
            <h3>{f.name}</h3>
            <p>{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fac-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .fac-card {
    display: grid;
    gap: 0.3rem;
  }
  .fac-icon {
    font-size: 1.8rem;
  }
  .fac-card h3 {
    margin: 0;
    color: var(--color-brand-dark);
    font-size: 1.05rem;
  }
  .fac-card p {
    margin: 0;
    color: #36453f;
    font-size: 0.92rem;
  }
</style>
