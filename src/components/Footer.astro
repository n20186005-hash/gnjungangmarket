---
import { ATTRACTION, SOURCES, SITE_NAME } from '../config';
import { ui, localizedPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].footer;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h3>{t.brandTitle}</h3>
      <p class="muted">
        {ATTRACTION.address.street}<br />
        전화 <a href={`tel:${ATTRACTION.telephone}`}>{ATTRACTION.telephoneDisplay}</a
        ><br />
        구글 평점 {ATTRACTION.rating}점 · {ATTRACTION.reviewCount.toLocaleString()}개 후기
      </p>
      <p class="muted small">{t.disclaimer}</p>
    </div>

    <nav aria-label={t.quickTitle}>
      <h3>{t.quickTitle}</h3>
      <ul>
        <li><a href={`#hours`}>{ui[locale].nav.hours}</a></li>
        <li><a href={`#food`}>{ui[locale].nav.food}</a></li>
        <li><a href={`#transport`}>{ui[locale].nav.transport}</a></li>
        <li><a href={`#weather`}>{ui[locale].nav.weather}</a></li>
        <li><a href={`#faq`}>{ui[locale].nav.faq}</a></li>
        <li>
          <a href={ATTRACTION.mapsUrl} target="_blank" rel="noopener noreferrer"
            >{ui[locale].nav.openMap}</a
          >
        </li>
      </ul>
    </nav>

    <div>
      <h3>{t.sourcesTitle}</h3>
      <ul>
        {
          SOURCES.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {SITE_NAME}</span>
    <span class="muted small">{t.tagline}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-brand-dark);
    color: #e8f0ec;
    padding-block: 2.5rem 1.5rem;
    margin-top: 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .site-footer h3 {
    color: #fff;
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .site-footer a {
    color: #cfe2db;
    text-decoration: none;
  }
  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .muted {
    color: #a9c2ba;
  }
  .small {
    font-size: 0.85rem;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.85rem;
  }
</style>
