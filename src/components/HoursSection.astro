---
import { ATTRACTION } from '../config';
import { ui, HOURS_DAILY, HOURS_NOTE, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].hours;
---

<section id="hours" class="section">
  <div class="container">
    <h2 class="section-title">{t.title}</h2>
    <p class="section-lead">{t.lead}</p>

    <div class="hours-grid">
      <div class="card hours-main">
        <h3>{t.generalTitle}</h3>
        <p class="hours-big">{HOURS_DAILY[locale]}</p>
        <p class="muted small">{HOURS_NOTE[locale]}</p>
      </div>
      <div class="card hours-tip">
        <h3>{t.tipTitle}</h3>
        <ul>
          {t.tips.map((tip) => <li>{tip}</li>)}
        </ul>
        <a
          class="btn btn-primary"
          href={ATTRACTION.mapsUrl}
          target="_blank"
          rel="noopener noreferrer">{t.mapCta}</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  .hours-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1rem;
  }
  .hours-main h3,
  .hours-tip h3 {
    margin: 0 0 0.6rem;
    color: var(--color-brand-dark);
  }
  .hours-big {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-brand);
    margin: 0 0 0.5rem;
  }
  .hours-tip ul {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    color: #36453f;
  }
  .muted {
    color: #6b776f;
  }
  .small {
    font-size: 0.85rem;
  }
  @media (max-width: 720px) {
    .hours-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
