---
import { FOODS, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const foods = FOODS[locale];
const meta = ui[locale].food;
---

<section id="food" class="section">
  <div class="container">
    <h2 class="section-title">{meta.title}</h2>
    <p class="section-lead">{meta.lead}</p>
    <div class="food-grid">
      {
        foods.map((f) => (
          <article class="card food-card">
            <h3>{f.name}</h3>
            <span class="food-en">{f.en}</span>
            <p>{f.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .food-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .food-card h3 {
    margin: 0 0 0.2rem;
    color: var(--color-brand-dark);
    font-size: 1.1rem;
  }
  .food-en {
    font-size: 0.8rem;
    color: #8a958e;
    font-weight: 700;
  }
  .food-card p {
    margin: 0.6rem 0 0;
    color: #36453f;
    font-size: 0.95rem;
  }
</style>
