---
import { SOURCES, ATTRACTION } from '../config';
import { ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].sources;
---

<section id="sources" class="section">
  <div class="container">
    <h2 class="section-title">{t.title}</h2>
    <p class="section-lead">{t.lead}</p>
    <ul class="source-list">
      {
        SOURCES.map((s) => (
          <li class="card">
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
            <span class="src-pub">{s.publisher}</span>
          </li>
        ))
      }
    </ul>
    <p class="muted small">{t.note}</p>
  </div>
</section>

<style>
  .source-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.6rem;
  }
  .source-list a {
    font-weight: 700;
    color: var(--color-brand-dark);
    text-decoration: none;
  }
  .source-list a:hover {
    text-decoration: underline;
  }
  .src-pub {
    display: block;
    font-size: 0.82rem;
    color: #6b776f;
    margin-top: 0.2rem;
  }
  .muted {
    color: #6b776f;
  }
  .small {
    font-size: 0.85rem;
  }
</style>
