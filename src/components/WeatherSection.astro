---
import { ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].weather;
---

<section id="weather" class="section">
  <div class="container">
    <h2 class="section-title">{t.title}</h2>
    <p class="section-lead">{t.lead}</p>

    <div id="weather-root" class="weather-root">
      <div class="card weather-loading">{t.loading}</div>
    </div>

    <p class="muted small">{t.note}</p>
  </div>
</section>

<style>
  .weather-loading {
    color: #6b776f;
  }
  .weather-root {
    display: grid;
    gap: 1rem;
  }
  .muted {
    color: #6b776f;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }
</style>

<script define:vars={{ locale }}>
  import {
    wmoLabel,
    kmhToBeaufort,
    beaufortLabel,
    uvLabel,
    buildAdvice,
    type WeatherPayload,
  } from '../lib/weather';
  import { ui, type Locale } from '../i18n';

  const L = locale;
  const TW = ui[L].weather;
  const root = document.getElementById('weather-root');
  if (root) {
    const render = (data: WeatherPayload) => {
      const now = data.current;
      const cur = wmoLabel(now.weather_code, L);
      const advice = buildAdvice(data, L);
      const days = (data.daily ?? []).slice(0, 7);

      const adviceHtml = [
        advice.risk.length
          ? `<div class="risk-banner"><strong>${TW.risk}</strong><ul>${advice.risk
              .map((r) => `<li>${r}</li>`)
              .join('')}</ul></div>`
          : '',
        advice.outfit.length
          ? `<div class="advice-card"><h4>${TW.outfit}</h4><ul>${advice.outfit
              .map((x) => `<li>${x}</li>`)
              .join('')}</ul></div>`
          : '',
        advice.plan.length
          ? `<div class="advice-card"><h4>${TW.plan}</h4><ul>${advice.plan
              .map((x) => `<li>${x}</li>`)
              .join('')}</ul></div>`
          : '',
        advice.items.length
          ? `<div class="advice-card"><h4>${TW.items}</h4><ul>${advice.items
              .map((x) => `<li>${x}</li>`)
              .join('')}</ul></div>`
          : '',
      ].join('');

      const dayHtml = days
        .map((d, i) => {
          const w = wmoLabel(d.weather_code, L);
          const label = i === 0 ? TW.today : TW.plusDay(i);
          return `<div class="day">
            <span class="day-name">${label}</span>
            <span class="day-icon">${w.icon}</span>
            <span class="day-label">${w.label}</span>
            <span class="day-temp">${Math.round(d.temperature_2m_min)}° / ${Math.round(
            d.temperature_2m_max
          )}°</span>
            <span class="day-meta">${TW.metaRain} ${d.precipitation_probability_max}% · ${TW.metaWind} ${beaufortLabel(
            d.wind_speed_10m_max,
            L
          )}(${kmhToBeaufort(d.wind_speed_10m_max)})) · ${TW.metaUv} ${uvLabel(
            L,
            d.uv_index_max
          )}</span>
          </div>`;
        })
        .join('');

      root.innerHTML = `
        <div class="card current">
          <div class="current-main">
            <span class="current-icon">${cur.icon}</span>
            <div>
              <div class="current-temp">${Math.round(now.temperature_2m)}°C</div>
              <div class="current-label">${cur.label}</div>
            </div>
          </div>
          <ul class="current-meta">
            <li>${TW.curFeels} ${Math.round(now.apparent_temperature)}°C</li>
            <li>${TW.curHumidity} ${now.relative_humidity_2m}%</li>
            <li>${TW.curWind} ${beaufortLabel(now.wind_speed_10m, L)} (${Math.round(
        now.wind_speed_10m
      )} km/h)</li>
            <li>${TW.curRain} ${now.precipitation} mm</li>
          </ul>
        </div>
        ${adviceHtml}
        <div class="forecast">${dayHtml}</div>
      `;
    };

    const fallback = () => {
      root.innerHTML = `<div class="card">${TW.fallback}</div>`;
    };

    fetch(`/api/weather?lang=${encodeURIComponent(L)}`)
      .then((r) => {
        if (!r.ok) throw new Error('bad');
        return r.json();
      })
      .then((d) => render(d as WeatherPayload))
      .catch(() => fallback());
  }
</script>

<style>
  .current {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .current-main {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .current-icon {
    font-size: 2.6rem;
  }
  .current-temp {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-brand-dark);
  }
  .current-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    color: #54625c;
    font-size: 0.92rem;
  }
  .forecast {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.6rem;
  }
  .day {
    background: #fff;
    border: 1px solid #e7e0cf;
    border-radius: 0.75rem;
    padding: 0.7rem;
    display: grid;
    gap: 0.2rem;
    text-align: center;
  }
  .day-name {
    font-weight: 700;
    color: var(--color-brand);
  }
  .day-icon {
    font-size: 1.6rem;
  }
  .day-temp {
    font-weight: 700;
  }
  .day-meta {
    font-size: 0.75rem;
    color: #6b776f;
  }
  .risk-banner ul,
  .advice-card ul {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }
  .advice-card h4 {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-brand-dark);
  }
</style>
