      <div class="mt-4 flex gap-2"><button id="cookie-reject" class="border border-[var(--ink)] px-4 py-2 text-sm font-bold">거부</button><button id="cookie-accept" class="bg-[var(--pine)] px-4 py-2 text-sm font-bold text-white">분석 허용</button></div>
