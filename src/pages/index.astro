    <script is:inline>
      const consentKey = 'gjm-analytics-consent';
      const banner = document.getElementById('cookie-banner');
      const loadGA = () => {
        if (document.querySelector('script[data-ga4]')) return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
        const script = document.createElement('script');
        script.async = true; script.dataset.ga4 = 'true';
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
        document.head.appendChild(script);
      };
      const choice = localStorage.getItem(consentKey);
      if (choice === 'yes') loadGA(); else if (choice !== 'no') banner?.classList.remove('hidden');
      document.getElementById('cookie-accept')?.addEventListener('click', () => { localStorage.setItem(consentKey,'yes'); banner?.classList.add('hidden'); loadGA(); });
      document.getElementById('cookie-reject')?.addEventListener('click', () => { localStorage.setItem(consentKey,'no'); banner?.classList.add('hidden'); });
      document.getElementById('cookie-settings')?.addEventListener('click', () => banner?.classList.remove('hidden'));
    </script>
    <script>
      if ((import.meta as any).env?.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
    <script>
      // @ts-nocheck
      (() => {
        const nowEl = document.getElementById('wx-now');
        const d7El = document.getElementById('wx-7d');
        const advEl = document.getElementById('wx-advice');
        const updEl = document.getElementById('wx-updated');
        if (!nowEl || !d7El) return;

        const WMO = {
          0:['맑음','☀️'], 1:['대체로 맑음','🌤️'], 2:['구름 조금','⛅'], 3:['흐림','☁️'],
          45:['안개','🌫️'], 48:['짙은 안개','🌫️'],
          51:['이슬비','🌦️'], 53:['이슬비','🌦️'], 55:['이슬비','🌦️'],
          56:['어는 이슬비','🌧️'], 57:['어는 이슬비','🌧️'],
          61:['약한 비','🌦️'], 63:['비','🌧️'], 65:['강한 비','🌧️'],
          66:['어는 비','🌧️'], 67:['어는 비','🌧️'],
          71:['약한 눈','🌨️'], 73:['눈','❄️'], 75:['강한 눈','❄️'], 77:['싸락눈','🌨️'],
          80:['소나기','🌦️'], 81:['소나기','🌧️'], 82:['강한 소나기','⛈️'],
          85:['눈 소나기','🌨️'], 86:['눈 소나기','❄️'],
          95:['뇌우','⛈️'], 96:['우박 동반 뇌우','⛈️'], 99:['우박 동반 뇌우','⛈️'],
        };
        function wmo(code){
          const [label, emoji] = WMO[code] || ['알 수 없음','🌡️'];
          return {
            label, emoji,
            isLightRain: [51,53,55,61,80].includes(code),
            isHeavyRain: [65,82,66,67].includes(code),
            isThunder: [95,96,99].includes(code),
            isFog: [45,48].includes(code),
            isClear: [0,1].includes(code),
            isCloudy: [2,3].includes(code),
            isSnow: [71,73,75,77,85,86].includes(code),
          };
        }
        function beaufort(kmh){
          if(kmh<1)return 0; if(kmh<6)return 1; if(kmh<12)return 2; if(kmh<20)return 3;
          if(kmh<29)return 4; if(kmh<39)return 5; if(kmh<50)return 6; if(kmh<62)return 7;
          if(kmh<75)return 8; if(kmh<89)return 9; if(kmh<103)return 10; if(kmh<118)return 11; return 12;
        }
        const WD = ['일','월','화','수','목','금','토'];
        function yoil(s){ const [y,m,d]=s.split('-').map(Number); return WD[new Date(y,m-1,d).getDay()]; }

        function buildAdvice(cur, day){
          const w = wmo(day.code);
          const tMax = day.tMax, tMin = day.tMin;
          const precip = day.precip, uv = day.uv, windLv = beaufort(day.windMax);
          const outfit=[], itinerary=[], items=[], alerts=[];
          if(precip>=60){ outfit.push('비가 올 확률이 높아 우산이나 우비를 챙기세요.'); itinerary.push('실내 관람을 우선하고, 야외 산행이나 바닷가 놀이는 미루는 게 좋겠어요.'); items.push('우산 / 우비'); }
          if(w.isLightRain){ outfit.push('비가 조금 와요. 길이 미끄러우니 걸을 때 주의하세요.'); itinerary.push('노천 체험은 만족도가 낮을 수 있어요.'); items.push('접이식 우산'); }
          if(w.isHeavyRain){ alerts.push('강우가 제법 세요. 계곡이나 저지대는 피하세요.'); itinerary.push('야외 놀이보다는 실내가 좋아요. 유람선·케이블카는 운휴할 수 있어요.'); items.push('우비 (바람이 불면 장우산은 비추천)'); }
          if(w.isThunder){ alerts.push('낙뢰 위험! 등산·해변 물놀이·나무 밑은 피하세요.'); itinerary.push('수상 놀이기구는 대부분 운휴해요.'); }
          if(w.isSnow){ outfit.push('눈이 와요. 미끄럼 방지 신발을 추천해요.'); items.push('장갑·방한 용품'); }
          if(tMax>=32){ outfit.push('기온이 높아요. 한낮 외출은 되도록 피하세요.'); itinerary.push('야외 활동 시간을 짧게 가져가세요.'); items.push('자외선 차단제·충분한 물·더위 대비 용품'); }
          if(uv>=5){ outfit.push('자외선이 강해요. 꼼꼼히 차단하세요.'); items.push('자외선 차단제·선글라스·모자'); }
          if(tMax<=10){ outfit.push('기온이 낮아요. 방한에 신경 쓰세요.'); items.push('두꺼운 겉옷·목도리'); }
          if((tMax-tMin)>8){ outfit.push('낮밤 일교차가 커요. 겉옷을 챙겨 입었다 벗었다 하세요.'); }
          if(windLv>=5 && windLv<7){ outfit.push('바람이 제법 불어요.'); itinerary.push('바닷가 유람선·야외 놀이기구는 휴업할 수 있어요.'); items.push('모자가 날아갈 수 있으니 주의, 통풍이 너무 큰 치마는 비추천'); }
          if(windLv>=7){ alerts.push('강풍 주의! 광고판·바닷가 암초에서 멀리 떨어져 있으세요.'); itinerary.push('해상 놀이기구는 대부분 운휴해요.'); }
          if(w.isClear){ outfit.push('날씨가 좋아 야외 관광하기 딱 좋아요.'); itinerary.push('일출·일몰 풍경 감상에 좋아요.'); items.push('자외선 차단 잊지 마세요'); }
          if(w.isCloudy){ outfit.push('빛이 부드러워 사진 찍기 좋아요.'); itinerary.push('폭염 없이 긴 시간 야외 산책하기 좋습니다.'); }
          if(w.isFog){ alerts.push('가시거리가 짧아요. 페리·항공편이 지연될 수 있어요.'); itinerary.push('바다·산 전망은 별로예요.'); items.push('마스크'); }
          return {outfit,itinerary,items,alerts};
        }

        function renderNow(cur, day){
          const w = wmo(cur.code);
          nowEl.innerHTML =
            '<div class="flex items-end gap-4">'+
              '<span class="text-6xl leading-none">'+w.emoji+'</span>'+
              '<div><p class="text-4xl font-black">'+Math.round(cur.temp)+'°</p>'+
              '<p class="text-sm font-bold text-black/70">'+w.label+'</p></div>'+
            '</div>'+
            '<p class="mt-4 text-sm text-black/70">최고 '+Math.round(day.tMax)+'° / 최저 '+Math.round(day.tMin)+'° · '+
            '강수확률 '+day.precip+'% · 바람 '+beaufort(day.windMax)+'급 ('+Math.round(day.windMax)+'km/h)</p>';
        }
        function render7d(daily){
          let cards='';
          for(let i=0;i<daily.time.length;i++){
            const w = wmo(daily.weather_code[i]);
            cards +=
              '<div class="rounded-xl border border-black/10 bg-white/60 p-3 text-center">'+
                '<p class="text-xs font-bold text-black/60">'+(i===0?'오늘':yoil(daily.time[i]))+'</p>'+
                '<p class="text-2xl my-1">'+w.emoji+'</p>'+
                '<p class="text-[11px] text-black/55">'+w.label+'</p>'+
                '<p class="mt-1 text-sm font-black">'+Math.round(daily.temperature_2m_max[i])+'°</p>'+
                '<p class="text-xs text-black/50">'+Math.round(daily.temperature_2m_min[i])+'°</p>'+
                '<p class="mt-1 text-[11px] text-[var(--sea)]">💧'+daily.precipitation_probability_max[i]+'%</p>'+
              '</div>';
          }
          d7El.innerHTML = '<div class="grid grid-cols-3 gap-3 sm:grid-cols-7">'+cards+'</div>';
        }
        function renderAdvice(a){
          const blocks = [['옷차림',a.outfit,'var(--pine)'],['놀이 팁',a.itinerary,'var(--sea)'],['챙길 물건',a.items,'var(--mustard)']];
          let html='';
          if(a.alerts.length){
            html += '<div class="rounded-xl border-2 border-red-500 bg-red-50 p-5">'+
                    '<p class="text-xs font-black uppercase tracking-[.2em] text-red-600">위험 주의</p>'+
                    '<ul class="mt-2 space-y-1 text-sm font-bold text-red-700">'+a.alerts.map(x=>'<li>⚠️ '+x+'</li>').join('')+'</ul></div>';
          }
          for(const [title, arr, color] of blocks){
            if(!arr.length) continue;
            html += '<div class="mt-5 rounded-xl border-2 border-[var(--ink)] bg-[var(--cream)] p-5">'+
                    '<h3 class="text-sm font-black" style="color:'+color+'">'+title+'</h3>'+
                    '<ul class="mt-2 space-y-1 text-sm leading-6 text-black/70">'+arr.map(x=>'<li>· '+x+'</li>').join('')+'</ul></div>';
          }
          if(!html){
            html = '<div class="mt-5 rounded-xl border-2 border-[var(--ink)] bg-[var(--cream)] p-5 text-sm text-black/70">특별한 날씨 주의사항은 없어요. 편안하게 방문하세요!</div>';
          }
          advEl.innerHTML = html;
          advEl.classList.remove('hidden');
        }

        async function init(){
          // Same-origin endpoint served by the Cloudflare Worker (server-side fetch + cache).
          const url = '/api/weather';
          try{
            const r = await fetch(url);
            if(!r.ok) throw new Error('HTTP '+r.status);
            const d = await r.json();
            const cur = { code:d.current.weather_code, temp:d.current.temperature_2m };
            const day = {
              code: d.daily.weather_code[0],
              tMax: d.daily.temperature_2m_max[0],
              tMin: d.daily.temperature_2m_min[0],
              precip: d.daily.precipitation_probability_max[0] ?? 0,
              uv: d.daily.uv_index_max[0] ?? 0,
              windMax: d.daily.wind_speed_10m_max[0],
            };
            renderNow(cur, day);
            render7d(d.daily);
            renderAdvice(buildAdvice(cur, day));
            updEl.textContent = '기준 시각: '+new Date().toLocaleString('ko-KR');
          }catch(e){
            nowEl.textContent = '날씨 정보를 불러오지 못했습니다. 인터넷 연결을 확인하고 잠시 후 다시 시도해 주세요.';
            d7El.textContent = '';
          }
        }
        init();
      })();
    </script>
  </body>
</html>
