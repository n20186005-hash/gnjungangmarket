---
import '../styles/global.css';

const place = {
  name: '강릉 중앙시장',
  alternateName: 'Gangneung Jungang Market',
  address: '강원특별자치도 강릉시 금성로 21',
  phone: '033-648-2285',
  lat: 37.7539884,
  lng: 128.8986105,
  hours: '08:30–21:00',
  rating: 4.0,
  reviewCount: 17088,
  mapsShareUrl: 'https://maps.app.goo.gl/81cqUJsHeewA21wy9',
  govtTourismUrl: 'https://www.gn.go.kr/www/contents.do?key=568',
};

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://gnjungangmarket.com';
const ogImageURL = `${siteBase}/brand/og-card.svg`;

const marketSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'TouristAttraction'],
  '@id': `${siteBase}/#attraction`,
  name: place.name,
  alternateName: ['Gangneung Jungang Market', '강릉 중앙시장', 'Gangneung Central Market'],
  description: '강릉 도심 한가운데에서 수산물, 농특산물, 생활잡화와 강릉 대표 먹거리를 만나는 전통시장. 점포별 영업시간은 다를 수 있습니다.',
  ...(canonicalURL ? { url: canonicalURL } : {}),
  telephone: '+82-33-648-2285',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '금성로 21',
    addressLocality: '강릉시',
    addressRegion: '강원특별자치도',
    addressCountry: 'KR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.lat,
    longitude: place.lng,
  },
  hasMap: place.mapsShareUrl,
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '08:30',
    closes: '21:00',
  }],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: place.rating,
    reviewCount: place.reviewCount,
    bestRating: 5,
  },
  isAccessibleForFree: true,
  sameAs: [place.mapsShareUrl, place.govtTourismUrl],
  image: [`${siteBase}/brand/og-card.svg`],
};

const faqs = [
  ['입장료가 있나요?', '시장 입장료는 없습니다. 음식, 상품, 체험 비용은 각 점포에서 별도로 결제합니다.'],
  ['몇 시에 방문하는 게 좋나요?', '장보기가 목적이면 오전부터 점심 사이, 먹거리와 시장 분위기를 함께 즐기려면 늦은 오후가 좋습니다. 점포마다 영업시간과 휴무가 다를 수 있습니다.'],
  ['주차는 어디에 하나요?', '남대천 둔치의 중앙시장 제1공영주차장, 타워형 제2공영주차장, 월화거리 노상 제3공영주차장, 금성로 노상주차장 등 주변 공영주차장을 이용할 수 있습니다. 요금과 운영 상태는 현장 안내를 확인하세요.'],
  ['강릉역에서 어떻게 가나요?', '강릉역에서 중앙시장까지는 약 2km입니다. 시내버스 또는 택시를 이용할 수 있고, 206번 버스 이용 시 신영극장 정류장에서 내려 도보로 이동하는 방법이 안내되어 있습니다.'],
  ['비가 와도 둘러볼 수 있나요?', '시장 내부의 아케이드 구간과 실내 점포를 중심으로 둘러볼 수 있습니다. 다만 월화거리 등 주변 산책 구간은 날씨 영향을 받습니다.'],
  ['추천 체류 시간은 어느 정도인가요?', '간식 위주라면 1~2시간, 식사와 지하 수산시장·월화거리 산책까지 묶으면 2~3시간 정도로 여유 있게 잡는 편이 좋습니다.'],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const food = [
  ['닭강정', '바삭한 튀김과 달콤매콤한 소스. 포장 간식으로 찾기 좋은 중앙시장 대표 메뉴.'],
  ['육쪽마늘빵', '강릉 여행 간식으로 널리 알려진 풍성한 마늘 풍미의 빵.'],
  ['소머리국밥', '시장 골목의 든든한 한 끼. 뜨끈한 국물 요리를 찾을 때 잘 어울립니다.'],
  ['지하 회센터', '동해에서 가까운 강릉의 시장답게 생선과 해산물을 만나는 핵심 공간.'],
  ['옹심이 · 칼국수', '감자 옹심이와 면 요리로 강원도의 담백하고 포근한 맛을 느껴보세요.'],
  ['커피콩빵', '커피도시 강릉의 이미지를 작은 간식으로 옮긴 시장표 기념 먹거리.'],
];

const nearby = [
  ['월화거리', '시장과 바로 이어지는 도심 산책길. 철도 지하화 이후 조성된 문화·휴식 공간이라 장보기 전후로 걷기 좋습니다.'],
  ['강릉대도호부 관아', '조선시대 강릉의 행정 중심을 보여주는 역사 공간. 중앙시장과 함께 구도심 동선을 만들기 좋습니다.'],
  ['임영관 삼문', '고려 시대 객사였던 임영관의 흔적을 품은 국보급 역사 경관. 관아 권역과 함께 둘러보기 좋습니다.'],
  ['오죽헌', '신사임당과 율곡 이이의 삶과 연결된 강릉의 대표 문화유산. 시장에서 식사한 뒤 이어 가기 좋은 반나절 코스입니다.'],
];

// 방문 편의 시설 — 점포·업체 이름은 추천하지 않고 ‘유형’ 중심으로 중립 서술합니다.
const facilities = [
  { icon: '🚻', title: '화장실', desc: '시장 주변에 공영 화장실과 상인회가 운영하는 시장 내 화장실이 있습니다. 위치는 현장 안내표지를 따르세요.' },
  { icon: '🅿️', title: '주차', desc: '남대천 둔치·타워형·월화거리 노상 등 공영주차장과 민영 주차장이 함께 있습니다. 요금과 잔여 면수는 현장 표지판을 확인하세요.' },
  { icon: '🍜', title: '식사·먹거리', desc: '국밥·분식·회·간식 등 다양한 형태의 식사 점포가 모여 있습니다. 특정 메뉴는 점포마다 영업시간이 다릅니다.' },
  { icon: '🛏️', title: '숙박', desc: '시장 인근 도보·차량 이동 거리에 모텔, 호텔, 게스트하우스 등 여러 형태의 숙박이 있습니다. 성수기 예약을 권장합니다.' },
  { icon: '🛒', title: '마트·편의점', desc: '대형마트와 편의점, 약국 등 생필품 구매 시설이 시내 곳곳에 있습니다. 장보기 전후 활용하기 좋습니다.' },
  { icon: '⛽', title: '주유·충전', desc: '도심 주요 도로변에 주유소와 전기차 충전소가 있습니다. 장거리 이동 전 미리 충전 상태를 확인하세요.' },
];

// 오시는 길 — 교통 수단별 상세 동선
const transportModes = [
  {
    icon: '✈️',
    title: '공항에서',
    summary: '가까운 양양국제공항 기준, 원거리 공항은 서울 경유 KTX 이용',
    steps: [
      '양양국제공항 도착 후 시외·시내버스 환승 또는 택시로 강릉 시내 이동(공항버스 약 1시간 내외, 택시 약 40~50분).',
      '인천·김포 등 원거리 공항에서는 공항철도·버스로 서울 경유 후 KTX 강릉행 승차, 강릉역에서 환승.',
      '강릉 시내 도착 후 시내버스 또는 택시로 중앙시장(금성로 21) 이동.',
    ],
  },
  {
    icon: '🚄',
    title: '기차(KTX)에서',
    summary: '강릉역 하차 후 버스 또는 택시로 약 2km',
    steps: [
      'KTX·청량리~강릉 누리로 등으로 강릉역 하차.',
      '시내버스(관광 안내 기준 206번 등) 이용 시 신영극장 정류장 하차 후 도보 약 5분.',
      '짐이 많거나 편할 때는 강릉역 앞 택시 이용(중앙시장까지 약 10분).',
    ],
  },
  {
    icon: '🚌',
    title: '버스터미널에서',
    summary: '강릉버스터미널 하차 후 시내버스·택시',
    steps: [
      '고속·시외버스로 강릉버스터미널 하차(터미널에서 중앙시장까지 약 2~3km).',
      '시내버스 환승 또는 택시 이용으로 금성로 일대 하차.',
      '터미널 인근에는 대중교통 환승 안내가 갖춰져 있어 현장 표지를 따라 이동하세요.',
    ],
  },
  {
    icon: '🚕',
    title: '택시 이용',
    summary: '강릉역·터미널·공항에서 중앙시장 직행',
    steps: [
      '강릉역·버스터미널·양양공항에서 택시 이용 시 중앙시장까지 기본 요금 수준~약 2km 구간.',
      '교통 상황에 따라 10~15분 내외, 성수기·퇴근 시간에는 대기 가능.',
      '목적지는 ‘중앙시장(금성로)’ 또는 ‘월화거리’로 말씀하시면 가까운 곳에 내려줍니다.',
    ],
  },
];

// 계절별 방문 전략 (강릉 기후 평년값 기준的一般 안내)
const seasonRows = [
  { season: '봄 · 3–5월', weather: '일교차 크고 건조, 늦은 3~4월 벚꽃, 황사 가능', food: '주꾸미·갓김치·봄나물·굴', tip: '겉옷 챙기기, 주말 벚꽃 인파', crowd: '중간' },
  { season: '여름 · 6–8월', weather: '무덥고 습함, 장마(6말~7월), 태풍(8~9월)', food: '닭강정·냉면·아이스·회', tip: '더위·소나기 대비, 실내 점포 활용', crowd: '높음(휴가철)' },
  { season: '가을 · 9–11월', weather: '가장 쾌적하고 건조, 단풍, 일교차', food: '육쪽마늘·전어·밤·대게(철)', tip: '방문 최적기, 겉옷 준비', crowd: '중간~높음(추석 전후)' },
  { season: '겨울 · 12–2월', weather: '춥고 강설 잦음(동해 영향), 강풍', food: '소머리국밥·옹심이·북어국', tip: '방한·미끄럼 주의, 폭설 시 교통 확인', crowd: '낮음(연휴 제외)' },
];

// 추천 코스
const generalRoutes = [
  { title: '반일 코스 · 2–3시간', desc: 'B1 수산·회센터 → 1F 먹거리 골목 → 월화거리 산책. 시장의 ‘바다 쪽 얼굴’과 골목 먹거리를 가볍게 둘러봅니다.' },
  { title: '종일 코스 · 반나절+', desc: '중앙시장 장보기 → 임영관 삼문 → 강릉대도호부 관아 → 오죽헌(택시·버스 환승). 구도심 역사 동선을 하루에 묶습니다.' },
];
const audienceRoutes = [
  { icon: '👨‍👩‍👧', title: '아이 동반 가족', desc: '평지 위주 동선, 먹거리 시식 위주, 월화거리 산책, 화장실 위치 미리 확인. 무거운 유모차는 골목이 좁으니 접이식 권장.' },
  { icon: '📷', title: '사진·자연 즐기기', desc: '이른 아침 부드러운 빛, 월화거리 건축과 시장 아케이드, 임영관 삼문 담장. 사람이 적은 오전이 촬영에 유리합니다.' },
  { icon: '♿', title: '저체력·무장애', desc: '동선을 짧게, 벤치와 화장실을 자주 활용, 실내 점포 중심, 공영주차장과 가까운 입구 이용. 경사·계단 구간이 있으니 여유 있게.' },
];

const photo1 = 'https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Gangneung_Jungang_Market_01.jpg/960px-Gangneung_Jungang_Market_01.jpg';
const photo2 = 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/0d/Gangneung_Jungang_Market_02.jpg/960px-Gangneung_Jungang_Market_02.jpg';
const photo3 = 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/Gangneung_Jungang_Market_20220501_003.jpg/960px-Gangneung_Jungang_Market_20220501_003.jpg';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#174f42" />
    <meta name="description" content="강릉 중앙시장 방문 전 알아두면 좋은 먹거리, 교통, 주차, 주변 명소, 이용 팁을 한눈에 정리한 비공식 여행 가이드." />
    <title>강릉 중앙시장 | 먹거리·교통·주차 한눈에 보기</title>
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content="강릉 중앙시장 | 먹거리·교통·주차 한눈에 보기" />
    <meta property="og:description" content="강릉 도심의 전통시장, 중앙시장을 맛있고 편하게 걷기 위한 비공식 여행 가이드." />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="강릉 중앙시장(강릉중앙시장) - 강릉시, 대한민국" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="강릉중앙시장" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(marketSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </head>
  <body class="market-grid">
    <div class="h-3 awning" aria-hidden="true"></div>
    <header class="relative z-20 mx-auto flex max-w-7xl items-center justify-between px-5 py-5 md:px-8">
      <a href="#top" class="flex items-center gap-3 no-underline" aria-label="강릉 중앙시장 가이드 홈">
        <img src="/brand/logo.svg" width="178" height="52" alt="강릉 중앙시장 가이드 로고" />
      </a>
      <nav class="hidden items-center gap-6 text-sm font-bold md:flex" aria-label="주요 메뉴">
        <a href="#taste" class="hover:text-[var(--chili)]">먹거리</a>
        <a href="#visit" class="hover:text-[var(--chili)]">방문정보</a>
        <a href="#transport" class="hover:text-[var(--chili)]">교통</a>
        <a href="#weather" class="hover:text-[var(--chili)]">날씨</a>
        <a href="#season" class="hover:text-[var(--chili)]">계절</a>
        <a href="#routes" class="hover:text-[var(--chili)]">코스</a>
        <a href="#story" class="hover:text-[var(--chili)]">이야기</a>
        <a href="#reviews" class="hover:text-[var(--chili)]">리뷰</a>
        <a href="#around" class="hover:text-[var(--chili)]">주변</a>
        <a href="#faq" class="hover:text-[var(--chili)]">FAQ</a>
      </nav>
      <a href="#map" class="stamp px-3 py-2 text-xs font-black text-[var(--pine)] no-underline">지도 보기</a>
    </header>

    <main id="top">
      <section class="relative mx-auto grid min-h-[78vh] max-w-7xl items-center gap-10 overflow-hidden px-5 pb-16 pt-6 md:grid-cols-[.9fr_1.1fr] md:px-8 md:pb-24 md:pt-12">
        <div class="relative z-10 order-2 md:order-1">
          <p class="section-kicker mb-5">Gangneung · Seongnam-dong</p>
