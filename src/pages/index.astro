    <div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-50 hidden max-w-xl border-2 border-[var(--ink)] bg-[var(--cream)] p-5 text-[var(--ink)] shadow-2xl md:left-auto md:right-6 md:w-[520px]" role="dialog" aria-label="쿠키 설정">
