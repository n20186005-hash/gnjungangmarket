---
import '../styles/global.css';
const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://gnjungangmarket.com';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>페이지를 찾을 수 없어요 · 강릉 중앙시장 가이드</title>
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="market-grid">
    <div class="h-3 awning" aria-hidden="true"></div>
    <main class="mx-auto flex min-h-[80vh] max-w-3xl flex-col items-center justify-center px-6 text-center">
      <p class="section-kicker">404</p>
      <h1 class="mt-3 text-6xl font-black tracking-[-.04em] md:text-8xl">골목을 잘못 들었나요?</h1>
      <p class="mt-6 max-w-md leading-7 text-black/65">찾으시는 페이지가 없거나 주소가 바뀌었어요. 강릉 중앙시장 가이드 첫 화면으로 돌아가 보세요.</p>
      <a href={siteBase + '/'} class="stamp mt-8 inline-block bg-[var(--pine)] px-6 py-3 text-sm font-black text-white no-underline">가이드 홈으로 돌아가기</a>
    </main>
  </body>
</html>
